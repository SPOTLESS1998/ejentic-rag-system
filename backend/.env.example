# ============================================================================
# Ejentic Enterprise RAG — backend environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- Multi-tenancy ---------------------------------------------------------
# Which client this instance serves. Must match a file in backend/clients/
# (e.g. "ejentic"). Each client gets its own index/namespace/models/persona.
RAG_CLIENT=ejentic

# --- Required API keys -----------------------------------------------------
PINECONE_API_KEY=
NVIDIA_API_KEY=

# --- Vector store (per-client defaults live in backend/clients/*.json) -----
# PINECONE_INDEX_NAME=ejentic-global
# PINECONE_NAMESPACE=ejentic-internal

# --- Model + retrieval overrides (optional per-process tuning) -------------
# Any of these overrides the active client's config for this process only.
# LLM_MODEL=mistralai/mistral-nemotron
# LLM_TIMEOUT=300                            # seconds per LLM request (NVIDIA calls can be slow)
# EMBED_MODEL=nvidia/nemotron-3-embed-1b
# RERANK_MODEL=nvidia/nv-rerankqa-mistral-4b-v3
# RETRIEVE_TOP_K=10
# RERANK_TOP_N=4
# CONFIDENCE_THRESHOLD=0.20
# MAX_CONTEXT_CHARS=1600
# HYBRID_ALPHA=0.5
# RERANK_ALPHA=0.5
# ENABLE_QUERY_REWRITE=true
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50

# --- Observability (optional) ----------------------------------------------
# LangSmith/LangChain tracing is switched on when LANGCHAIN_API_KEY is set.
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=Ejentic-RAG-Agent
# LANGCHAIN_TRACING_V2=false
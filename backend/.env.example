# ============================================================================
# Ejentic Enterprise RAG — backend environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- Multi-tenancy ---------------------------------------------------------
# Which client this instance serves. Must match a file in backend/clients/
# (e.g. "ejentic"). Each client gets its own index/namespace/models/persona.
RAG_CLIENT=ejentic

# --- Required API keys -----------------------------------------------------
PINECONE_API_KEY=
NVIDIA_API_KEY=

# --- Clearance keys: THE SECURITY BOUNDARY ---------------------------------
# One key per role. The server reads the caller's clearance FROM THE KEY, so a
# request can no longer just declare `"clearance_level": "executive"` and read
# board-only material — which is exactly what it could do before these existed.
#
# The client config (backend/clients/<id>.json) names these variables; it never
# holds their values. Generate one per role, each different:
#
#     openssl rand -hex 32
#
# Then set "auth": {"required": true} in the client config. With required=true
# and none of these set, the server REFUSES TO BOOT rather than serve an instance
# that cannot authenticate anyone.
RAG_KEY_GUEST=
RAG_KEY_EMPLOYEE=
RAG_KEY_EXECUTIVE=

# --- Browser access --------------------------------------------------------
# Origins allowed to call this backend from a browser. Was `*` with credentials
# enabled, which let any web page read a deployed instance from a visitor's
# session. Comma-separated; add your real frontend origin before deploying.
# CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# --- Audit DB (optional) ---------------------------------------------------
# Defaults to backend/data/<RAG_CLIENT>/audit.db — per-tenant by path, and every
# row also carries its client. Override only for tests or an external volume.
# RAG_AUDIT_DB=

# --- Vector store (per-client defaults live in backend/clients/*.json) -----
# PINECONE_INDEX_NAME=ejentic-global
# PINECONE_NAMESPACE=ejentic-internal

# --- Model + retrieval overrides (optional per-process tuning) -------------
# Any of these overrides the active client's config for this process only.
# LLM_MODEL=mistralai/mistral-nemotron
# LLM_TIMEOUT=300                            # seconds per LLM request (NVIDIA calls can be slow)
# EMBED_MODEL=nvidia/nemotron-3-embed-1b
# RERANK_MODEL=nvidia/nv-rerankqa-mistral-4b-v3
# RETRIEVE_TOP_K=10
# RERANK_TOP_N=4
# CONFIDENCE_THRESHOLD=0.20
# MAX_CONTEXT_CHARS=1600
# HYBRID_ALPHA=0.5
# RERANK_ALPHA=0.5
# ENABLE_QUERY_REWRITE=true
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50

# --- Observability (optional) ----------------------------------------------
# LangSmith/LangChain tracing is switched on when LANGCHAIN_API_KEY is set.
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=Ejentic-RAG-Agent
# LANGCHAIN_TRACING_V2=false
# --- Optional LLM provider swap (LLM only; embeddings stay on NVIDIA) --------
# If the NVIDIA hosted model degrades (hung streams / intermittent 500s), point
# the LLM at any OpenAI-compatible endpoint — e.g. Gemini's:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_API_KEY=<a Google API key>          (falls back to NVIDIA_API_KEY)
# and set "llm_model" in clients/<tenant>.json to that provider's model name
# (e.g. "gemini-flash-latest"). Unset both to return to the NVIDIA stack.
#
# Note: setting LLM_BASE_URL also forces the client into chat mode
# (is_chat_model=True). The NVIDIA client infers chat-vs-completion from its own
# table of NVIDIA model names, so an outside provider's name falls through to the
# legacy /completions endpoint — which OpenAI-compatible providers usually do not
# implement, producing a 404 that merely LOOKS like a flaky upstream. See
# LLM_SWAP_KWARGS in main.py.
LLM_BASE_URL=""
LLM_API_KEY=""

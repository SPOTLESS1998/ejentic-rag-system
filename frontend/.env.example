# ============================================================================
# Ejentic RAG frontend — environment configuration
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# ============================================================================

# Where the FastAPI backend lives. Read on the SERVER only (route handlers), so
# it is not exposed to the browser.
RAG_BACKEND_URL=http://localhost:8002

# --- The API key this deployment authenticates as --------------------------
# NOTE THE MISSING `NEXT_PUBLIC_` PREFIX, AND KEEP IT MISSING.
#
# `NEXT_PUBLIC_*` values are inlined into the JavaScript sent to the browser.
# A clearance key there is a PUBLIC key: anyone can open devtools, read it, and
# hold whatever clearance it grants. That is why the browser talks to
# /api/rag/* instead — those route handlers run on the server, add this key on
# the way out, and never send it downstream.
#
# Use the key for the clearance this whole frontend should have. A UI that needs
# per-user clearance needs per-user login, and this key is then the app's own
# identity, not the visitor's.
RAG_API_KEY=
